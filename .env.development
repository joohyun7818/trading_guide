# AlphaFlow US v2 - Development Environment

ENV=development

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=

# AI Settings
USE_HAIKU=false

# Database (구 프로젝트와 같은 DB 공유 - 테이블명 겹치지 않음)
DATABASE_URL=postgresql://alphaflow:alphaflow123@localhost:5432/alphaflow_us

# Application Server
APP_HOST=0.0.0.0
APP_PORT=8001

# CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:3001

# Logging
LOG_LEVEL=INFO
