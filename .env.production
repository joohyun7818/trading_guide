# AlphaFlow US v2 - Production Environment

ENV=production

# API Keys
GEMINI_API_KEY=your_production_gemini_api_key_here
ANTHROPIC_API_KEY=your_production_anthropic_api_key_here

# AI Settings
USE_HAIKU=true

# Database
DATABASE_URL=postgresql://alphaflow:secure_password_here@db_host:5432/alphaflow_us

# Application Server
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS
CORS_ORIGINS=https://yourdomain.com

# Logging
LOG_LEVEL=WARNING
